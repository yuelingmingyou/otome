<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🎀 Otome Collection</title>
    <link rel="stylesheet" href="css/style.css">
</head>
<body>
    <!-- 背景装饰 -->
    <div class="bg-decoration">
        <div class="lace-pattern"></div>
    </div>

    <!-- 头部 -->
    <header class="site-header">
        <div class="header-inner">
            <div class="logo">
                <span class="bow">🎀</span>
                <h1>Otome Memory</h1>
            </div>
            
            <div class="search-box">
                <span class="search-icon">🔍</span>
                <input type="text" id="searchInput" placeholder="搜索剧本、画师、声优...">
            </div>

            <div class="header-actions">
                <button class="btn btn-pink" onclick="app.openModal('add')">
                    <span>＋</span> 添加游戏
                </button>
                <label class="btn btn-blue">
                    <span>📥</span> 导入
                    <input type="file" id="importFile" accept=".json" hidden onchange="app.importData(this)">
                </label>
                <button class="btn btn-purple" onclick="app.exportData()">
                    <span>📤</span> 导出
                </button>
            </div>
        </div>
    </header>

    <!-- 主内容 -->
    <main class="main-content">
        <div id="gameGrid" class="game-grid"></div>
        
        <div id="emptyState" class="empty-state hidden">
            <div class="empty-bow">🎀</div>
            <h2>还没有游戏记录哦~</h2>
            <p>点击右上角添加你的第一款乙女游戏吧！</p>
        </div>
    </main>

    <!-- 添加/编辑弹窗 -->
    <div id="formModal" class="modal hidden">
        <div class="modal-content modal-animate">
            <div class="modal-header">
                <h2>✨ 记录新游戏</h2>
                <button class="close-btn" onclick="app.closeModal('form')">×</button>
            </div>
            
            <form id="gameForm" onsubmit="app.saveGame(event)">
                <input type="hidden" id="gameId">
                
                <!-- 图片上传 -->
                <div class="image-upload-area">
                    <div class="upload-box" onclick="document.getElementById('coverInput').click()">
                        <img id="previewImage" class="preview-img hidden">
                        <div id="uploadPlaceholder" class="upload-placeholder">
                            <div class="upload-icon">🖼️</div>
                            <p>点击上传封面</p>
                        </div>
                    </div>
                    <input type="file" id="coverInput" accept="image/*" hidden onchange="app.handleImageUpload(this)">
                </div>

                <!-- 表单字段 -->
                <div class="form-grid">
                    <div class="form-group full-width">
                        <label>游戏名</label>
                        <input type="text" id="title" required>
                    </div>
                    
                    <div class="form-group">
                        <label>画师</label>
                        <input type="text" id="artist">
                    </div>
                    
                    <div class="form-group">
                        <label>剧本</label>
                        <input type="text" id="writer">
                    </div>
                    
                    <div class="form-group full-width">
                        <label>声优 (用逗号分隔)</label>
                        <textarea id="voiceActors" rows="2"></textarea>
                    </div>

                    <div class="form-group">
                        <label>发售/开发</label>
                        <input type="text" id="developer">
                    </div>
                    
                    <div class="form-group">
                        <label>发售时间</label>
                        <input type="text" id="releaseDate" placeholder="例如: 2013年8月30日">
                    </div>

                    <div class="form-group">
                        <label>平台</label>
                        <input type="text" id="platform">
                    </div>
                    
                    <div class="form-group">
                        <label>游玩时间</label>
                        <input type="text" id="playTime">
                    </div>

                    <div class="form-group full-width">
                        <label>评价</label>
                        <div class="star-input" id="starRatingInput">
                            <span class="star" data-val="1">☆</span>
                            <span class="star" data-val="2">☆</span>
                            <span class="star" data-val="3">☆</span>
                            <span class="star" data-val="4">☆</span>
                            <span class="star" data-val="5">☆</span>
                        </div>
                        <input type="hidden" id="rating" value="0">
                    </div>

                    <div class="form-group full-width">
                        <label>感想/备注</label>
                        <textarea id="review" rows="3"></textarea>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="button" class="btn btn-secondary" onclick="app.closeModal('form')">取消</button>
                    <button type="submit" class="btn btn-primary">保存</button>
                </div>
            </form>
        </div>
    </div>

    <!-- 详情弹窗 -->
    <div id="detailModal" class="modal hidden">
        <div class="modal-content detail-content modal-animate">
            <button class="close-btn detail-close" onclick="app.closeModal('detail')">×</button>
            
            <div class="detail-layout">
                <div class="detail-image-section">
                    <img id="detailImage" src="" alt="游戏封面">
                    <h2 id="detailTitleOverlay" class="mobile-title"></h2>
                </div>
                
                <div class="detail-info-section">
                    <div class="detail-bow">🎀</div>
                    <h2 id="detailTitle" class="detail-title"></h2>
                    
                    <div class="info-list">
                        <div class="info-item">
                            <span class="info-label">画师</span>
                            <span class="info-value" id="detailArtist"></span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">剧本</span>
                            <span class="info-value" id="detailWriter"></span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">声优</span>
                            <span class="info-value voice-actors" id="detailVoice"></span>
                        </div>
                        
                        <div class="info-divider"></div>
                        
                        <div class="info-grid-2">
                            <div class="info-item">
                                <span class="info-label small">发售/开发</span>
                                <span class="info-value" id="detailDev"></span>
                            </div>
                            <div class="info-item">
                                <span class="info-label small">平台</span>
                                <span class="info-value" id="detailPlatform"></span>
                            </div>
                            <div class="info-item">
                                <span class="info-label small">发售时间</span>
                                <span class="info-value" id="detailDate"></span>
                            </div>
                            <div class="info-item">
                                <span class="info-label small">游玩时间</span>
                                <span class="info-value" id="detailTime"></span>
                            </div>
                        </div>
                        
                        <div class="info-item">
                            <span class="info-label small">评价</span>
                            <div class="star-display" id="detailRating"></div>
                        </div>
                        
                        <div class="review-box">
                            <span class="info-label small">感想</span>
                            <p id="detailReview"></p>
                        </div>
                    </div>
                    
                    <div class="detail-actions">
                        <button class="text-btn edit" onclick="app.editCurrentGame()">✏️ 编辑</button>
                        <button class="text-btn delete" onclick="app.deleteCurrentGame()">🗑️ 删除</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="js/app.js"></script>
</body>
</html>

